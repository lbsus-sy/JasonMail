{
  "name": "jasonmail",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted single-admin webmail for Cloudflare Workers",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --disable-warning=ExperimentalWarning --test",
    "dev": "wrangler dev",
    "preview": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply jasonmail --remote",
    "db:migrate:local": "wrangler d1 migrations apply jasonmail --local",
    "db:migrate:remote": "wrangler d1 migrations apply jasonmail --remote"
  },
  "devDependencies": {
    "wrangler": "^4.41.0"
  },
  "engines": {
    "node": ">=22"
  }
}

